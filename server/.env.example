PORT = 5000
MONGODB_URI = mongodb://127.0.0.1:27017/whodunit
GEMINI_API_KEY = your_key_here
GEMINI_MODEL = gemini-3.1-flash-lite
CLIENT_ORIGIN = http://localhost:5173
NODE_ENV = development
MOCK_AI = false
# Set to 1 only behind one trusted reverse proxy (e.g. Render).
TRUST_PROXY = 0
# Optional local DNS workaround. Leave empty on Render to use its system DNS.
DNS_SERVERS =
